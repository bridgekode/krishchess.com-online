{
  // Krish Chess online: the game rooms. The website (krishchess.com) connects here.
  "name": "krish-chess-online",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "vars": { "ROOM_HOURS": "24" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
